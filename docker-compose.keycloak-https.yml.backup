# Docker Compose file for HTTPS-enabled Keycloak

services:
  # Keycloak Database
  postgres-keycloak:
    image: postgres:15
    container_name: postgres-keycloak
    env_file:
      - config.env
      - secrets.env
    environment:
      POSTGRES_DB: keycloak
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: ${KEYCLOAK_DB_PASSWORD}
    volumes:
      - postgres_keycloak_data:/var/lib/postgresql/data
    ports:
      - "5433:5432"
    networks:
      - keycloak-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak -d keycloak"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Keycloak IAM Server with HTTPS
  keycloak:
    image: quay.io/keycloak/keycloak:latest
    container_name: keycloak-cms
    env_file:
      - config.env
      - secrets.env
    environment:
      KEYCLOAK_ADMIN: ${KEYCLOAK_ADMIN_USER}
      KEYCLOAK_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://postgres-keycloak:5432/keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD}
    command: start-dev --https-port=8443 --https-certificate-file=/opt/keycloak/conf/cert.pem --https-certificate-key-file=/opt/keycloak/conf/key.pem --health-enabled=true
    ports:
      - "8443:8443"
    volumes:
      - keycloak_data:/opt/keycloak/data
      - ./deployment/keycloak-certs:/opt/keycloak/conf:ro
    depends_on:
      postgres-keycloak:
        condition: service_healthy
    networks:
      - keycloak-network
    healthcheck:
      test: ["CMD", "curl", "-f", "-k", "https://localhost:8443/health"]
      interval: 30s
      timeout: 10s
      retries: 3

volumes:
  postgres_keycloak_data:
    driver: local
  keycloak_data:
    driver: local

networks:
  keycloak-network:
    driver: bridge
