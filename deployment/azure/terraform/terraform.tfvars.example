# Copy to terraform.tfvars and fill in values
# az account show --query '{subscriptionId:id, tenantId:tenantId}'

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
location        = "eastus"

resource_group_name = "can-dev-compute-rg"
vnet_cidr           = "10.10.0.0/16"
cluster_name        = "can-dev-aks"
app_domain          = "app.dev.example.com"

# Environment & versioning (required for production)
environment         = "dev"          # dev | test | staging | prod
release_version     = "0.0.0-dev"     # semver → cms-release tag
image_tag           = ""              # git SHA or semver; empty uses release_version
tag_owner           = "platform-team"
data_classification = "internal"
cost_center         = "TBD"

node_count = 3
vm_size    = "Standard_D4s_v5"

db_name     = "contractmanagement"
db_user     = "canadmin"
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Microsoft Entra ID (AUTH_PROVIDER=entra — Keycloak is local-only)
create_entra_apps              = true
create_entra_api_client_secret = true
entra_grant_admin_consent      = true
# entra_app_owners             = ["00000000-0000-0000-0000-000000000000"]
# entra_api_audience           = "api://cms-dev-api"
# entra_redirect_uri           = "https://app.dev.example.com/login"
#
# Reuse existing app registrations instead of creating:
# create_entra_apps     = false
# entra_client_id       = "…"
# entra_api_client_id   = "…"
# entra_api_audience    = "api://cms-dev-api"
# entra_client_secret   = "…"

repository_name = "cancontractmgmt"

# Platform data plane (defaults: on)
enable_key_vault         = true
enable_storage           = true
enable_workload_identity = true
enable_private_endpoints = false   # set true after private DNS zones are ready

# Phase 2 optional
enable_edge  = false
enable_spire = false
# spiffe_trust_domain = "can.dev.azure.example"

project_tags = {}
