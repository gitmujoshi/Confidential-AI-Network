# Copy to terraform.tfvars and fill in values

tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_id   = "ocid1.compartment.oc1..example"

# Environment & versioning (required for production)
environment      = "dev"          # dev | test | staging | prod
release_version  = "0.0.0-dev"     # semver → cms-release tag
image_tag        = ""              # git SHA or semver; empty uses release_version, then latest (dev only)
tag_owner        = "platform-team"
data_classification = "internal"   # public | internal | confidential | restricted
cost_center      = "TBD"

# Optional: OCI defined-tag namespace for IAM tag-based policies (create in tenancy first)
# defined_tag_namespace = "cms-tags"

vcn_cidr = "10.0.0.0/16"

cluster_name       = "can-dev-oke"
kubernetes_version = "v1.28.2"
node_pool_size     = 3
node_shape         = "VM.Standard.E4.Flex"
node_ocpus         = 2
node_memory_in_gbs = 16

db_name     = "contractmanagement"
db_password = "CHANGE_ME_STRONG_PASSWORD"
db_size     = 1

lb_name         = "can-dev-lb"
repository_name = "confidential-ai-network"
app_domain      = "app.dev.example.com"

# OCI IAM Identity Domains — created by modules/identity (default)
create_identity_domain = true
create_identity_groups = true
create_identity_apps   = true
identity_domain_license_type = "free"
# identity_domain_display_name = "cms-dev-id"
# Optional bootstrap admin for new domain (all four required together):
# identity_domain_admin_email      = "admin@example.com"
# identity_domain_admin_first_name = "Platform"
# identity_domain_admin_last_name  = "Admin"
# identity_domain_admin_user_name  = "platform.admin"

# To reuse an existing domain instead:
# create_identity_domain      = false
# existing_identity_domain_id = "ocid1.domain.oc1.."
# oci_identity_domain_url     = "https://idcs-XXXX.identity.oraclecloud.com"
# oci_identity_client_id      = "SPA_CLIENT_ID"
# oci_identity_api_client_id  = "API_CLIENT_ID"
# oci_identity_client_secret  = "CHANGE_ME"

oci_identity_role_claim = "groups"
# oci_identity_redirect_uri = "https://app.dev.example.com/login"
oci_cloud_gate_enabled  = true
identity_allow_all_url_schemes = true

ethereum_network  = "goerli"
infura_project_id = ""

# Optional overrides merged onto cms-* standard tags
project_tags = {}
