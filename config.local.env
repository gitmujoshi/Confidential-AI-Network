# Local Development Configuration for Model Training Environment
# This file provides local development settings for testing TEE functionality

# Environment
NODE_ENV=development
TEE_MODE=local

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management_local
DB_USER=postgres
DB_PASSWORD=postgres

# Training Environment Configuration
TRAINING_MODE=local
TRAINING_BASE_PATH=./local-tee
TRAINING_CONTAINER_IMAGE=training-container:local
TRAINING_DOCKER_COMPOSE_FILE=./local-tee/docker-compose.yml

# Local TEE Configuration
LOCAL_TEE_ENABLED=true
LOCAL_TEE_ATTESTATION_ENABLED=true
LOCAL_TEE_CONTAINER_PREFIX=local-tee
LOCAL_TEE_DATA_PATH=./local-tee/data
LOCAL_TEE_OUTPUT_PATH=./local-tee/outputs
LOCAL_TEE_LOGS_PATH=./local-tee/logs

# Training Parameters
DEFAULT_TRAINING_EPOCHS=10
DEFAULT_BATCH_SIZE=32
DEFAULT_LEARNING_RATE=0.001
DEFAULT_ALGORITHM=adam

# Monitoring Configuration
TRAINING_MONITORING_ENABLED=true
TRAINING_MONITORING_INTERVAL=30000
TRAINING_PROGRESS_UPDATE_INTERVAL=5000

# Provenance Configuration
PROVENANCE_ENABLED=true
PROVENANCE_MODE=local
PROVENANCE_STORAGE_PATH=./local-tee/provenance

# Security Configuration
LOCAL_ATTESTATION_KEYS_PATH=./local-tee/attestations
LOCAL_ENCRYPTION_ENABLED=true
LOCAL_ACCESS_CONTROL_ENABLED=true

# Development Features
DEBUG_TRAINING=true
VERBOSE_LOGGING=true
MOCK_CLOUD_PROVIDERS=true
SIMULATE_TRAINING_DELAYS=true

# API Configuration
API_PORT=3001
API_HOST=localhost
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=./logs/training.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Testing Configuration
TEST_MODE=true
TEST_DATA_PATH=./test-data
TEST_OUTPUT_PATH=./test-outputs
