    "test:e2e:all": "node tests/e2e/index.js all",
    "test:e2e:quick": "node tests/e2e/index.js quick",
    "test:e2e:setup": "node tests/e2e/index.js setup",
    "test:e2e:cleanup": "node tests/e2e/index.js cleanup",
    "test:e2e:status": "node tests/e2e/index.js status",
