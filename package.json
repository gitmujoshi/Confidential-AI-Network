{
  "name": "contract-management-app",
  "version": "1.0.0",
  "description": "Smart Contract Management App for AI Training Data",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "blockchain": "cd blockchain && npm run node",
    "deploy": "cd blockchain && npm run deploy",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../blockchain && npm install",
    "setup-db": "cd backend && npm run setup-db",
    "create-wallets": "cd backend && npm run create-wallets",
    "register-hardhat": "cd backend && npm run register-hardhat",
    "test:mock": "NODE_ENV=test node -r ./tests/test-env.js ./node_modules/.bin/jest --testPathPattern=mock|models|api|core|security|performance --runInBand --setupFilesAfterEnv=./tests/setup.js",
    "test:integration": "NODE_ENV=test node -r ./tests/test-env.js ./node_modules/.bin/jest --testPathPattern=integration|blockchainService|registration-integration|simple-ai-model --runInBand --setupFilesAfterEnv=./tests/setup.js",
    "test:config": "node test-config-validation.js",
    "test:e2e": "node run-e2e-tests.js",
    "test:e2e:verbose": "VERBOSE=true node run-e2e-tests.js",
    "test:e2e:mocha": "cd tests && mocha e2e-user-registration-first-login.js --timeout 15000",
    "test:comprehensive": "node tests/run-comprehensive-tests.js",
    "test:provenance": "cd tests && npx mocha provenance-tracking.test.js --timeout 60000",
    "test:tee": "cd tests && npx mocha multi-cloud-tee.test.js --timeout 90000",
    "test:model-upload": "cd tests && npx mocha tdc-model-upload-tee.test.js --timeout 120000",
    "test:monitoring": "cd tests && npx mocha ccrp-environment-monitoring.test.js --timeout 60000",
    "test": "NODE_ENV=test node -r ./tests/test-env.js ./node_modules/.bin/jest --runInBand --setupFilesAfterEnv=./tests/setup.js"
  },
  "keywords": [
    "blockchain",
    "smart-contracts",
    "ai",
    "training-data"
  ],
  "author": "Contract Management Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "colors": "^1.4.0",
    "concurrently": "^8.2.2",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "merkletreejs": "^0.5.2",
    "playwright": "^1.55.0",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "axios": "^1.10.0"
  }
}
