# Secrets and Sensitive Configuration
# This file contains sensitive data and should NOT be committed to version control
# Copy this file to secrets.env at the repository root. Do not commit secrets.env.
# The full list is docs/deployment/README.md.

# Database Passwords
# Application Database (postgres-app)
DB_PASSWORD=
POSTGRES_PASSWORD=

# Keycloak Database (postgres-keycloak)
KEYCLOAK_DB_PASSWORD=

# JWT Secrets
JWT_SECRET=

# Keycloak Secrets
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=

# Email Credentials
EMAIL_PASS=

# Vault Token
VAULT_TOKEN=

# Blockchain Private Keys (if needed)
# BLOCKCHAIN_PRIVATE_KEY=your-private-key-here

# API Keys (if needed)
# EXTERNAL_API_KEY=your-api-key-here

# Data Encryption Key
DATA_ENCRYPTION_KEY=
