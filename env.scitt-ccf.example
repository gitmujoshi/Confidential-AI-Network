# SCITT CCF Integration Environment Configuration
# Copy this file to .env.scitt-ccf and modify as needed for your environment

# =============================================================================
# SCITT CCF Configuration
# =============================================================================

# SCITT CCF Node Configuration
SCITT_CCF_ENABLED=true
SCITT_CCF_NODE_URL=https://127.0.0.1:8000
SCITT_CCF_GOVERNANCE_URL=https://127.0.0.1:8001
SCITT_CCF_PLATFORM=virtual  # virtual, snp (AMD SEV-SNP)
SCITT_CCF_TEE_ENABLED=false
SCITT_CCF_API_KEY=dev-key-change-in-production

# SCITT CCF Network Configuration
CCF_NETWORK=development
CCF_NODE_COUNT=1
CCF_HTTP_TIMEOUT=30
CCF_MAX_REQUEST_SIZE=10485760  # 10MB

# =============================================================================
# Migration Configuration
# =============================================================================

# Migration Mode: ETHEREUM_ONLY, SCITT_CCF_ONLY, HYBRID
MIGRATION_MODE=HYBRID

# Migration Settings
ROLLBACK_ENABLED=true
PARALLEL_MIGRATION=true
MIGRATION_BATCH_SIZE=10
MIGRATION_RETRY_ATTEMPTS=3
MIGRATION_RETRY_DELAY=5000  # 5 seconds

# =============================================================================
# Health Monitoring Configuration
# =============================================================================

# Health Check Intervals (in milliseconds)
HEALTH_CHECK_INTERVAL=30000  # 30 seconds
HEALTH_CHECK_TIMEOUT=5000    # 5 seconds
HEALTH_CHECK_RETRIES=3

# Alert Thresholds
ALERT_RESPONSE_TIME_THRESHOLD=5000  # 5 seconds
ALERT_ERROR_RATE_THRESHOLD=0.1      # 10%
ALERT_CONSECUTIVE_FAILURES=3

# =============================================================================
# Performance Configuration
# =============================================================================

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_HISTORY_SIZE=100
PERFORMANCE_CLEANUP_INTERVAL=3600000  # 1 hour

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL=300000  # 5 minutes
CACHE_MAX_SIZE=1000

# =============================================================================
# Security Configuration
# =============================================================================

# TEE (Trusted Execution Environment) Configuration
TEE_ATTESTATION_ENABLED=false
TEE_ATTESTATION_URL=https://attestation.service.com
TEE_ATTESTATION_TIMEOUT=10000

# Encryption Configuration
ENCRYPTION_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY_ROTATION_INTERVAL=86400000  # 24 hours

# =============================================================================
# Logging Configuration
# =============================================================================

# Log Levels: ERROR, WARN, INFO, DEBUG, TRACE
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/scitt-ccf.log
LOG_FILE_MAX_SIZE=10485760  # 10MB
LOG_FILE_MAX_FILES=5

# =============================================================================
# Development Configuration
# =============================================================================

# Development Mode
NODE_ENV=development
DEBUG_ENABLED=true
DEBUG_LEVEL=info

# Test Configuration
TEST_MODE=false
TEST_DATA_CLEANUP=true
TEST_DATA_CLEANUP_INTERVAL=3600000  # 1 hour

# =============================================================================
# Database Configuration
# =============================================================================

# SCITT CCF Database (if using separate database)
SCITT_CCF_DB_HOST=localhost
SCITT_CCF_DB_PORT=5434
SCITT_CCF_DB_NAME=scitt_ccf_dev
SCITT_CCF_DB_USER=scitt_ccf
SCITT_CCF_DB_PASSWORD=scitt_ccf_dev_pass

# =============================================================================
# External Services Configuration
# =============================================================================

# Monitoring Services
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3000

# Alerting Services
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=alerts@contractflow.pro

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/Disable specific features
FEATURE_CONFIDENTIAL_COMPUTING=false
FEATURE_TEE_ATTESTATION=false
FEATURE_PERFORMANCE_BENCHMARKING=true
FEATURE_AUTO_MIGRATION=false
FEATURE_ROLLBACK_AUTOMATION=false

# =============================================================================
# Backup and Recovery Configuration
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000  # 24 hours
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups/scitt-ccf

# Recovery Configuration
RECOVERY_ENABLED=true
RECOVERY_AUTO_RESTORE=false
RECOVERY_VERIFICATION_REQUIRED=true

# =============================================================================
# Network Configuration
# =============================================================================

# Network Timeouts
NETWORK_TIMEOUT=30000
NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_DELAY=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Maintenance Configuration
# =============================================================================

# Maintenance Windows
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_DURATION=120  # minutes

# Cleanup Jobs
CLEANUP_OLD_LOGS_ENABLED=true
CLEANUP_OLD_LOGS_DAYS=30
CLEANUP_OLD_HEALTH_LOGS_ENABLED=true
CLEANUP_OLD_HEALTH_LOGS_DAYS=7

# =============================================================================
# Override Default Values
# =============================================================================

# Override any default values from the main .env file
# These will take precedence over the main configuration

# Example overrides:
# BLOCKCHAIN_ENABLED=true
# DATABASE_URL=***REMOVED-DB_PASSWORD***ql://user:pass@localhost:5432/contractflow_scitt
# JWT_SECRET=your-jwt-secret-here
