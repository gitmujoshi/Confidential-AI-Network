# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# IMPORTANT: Change username and password in production!
DATABASE_URL=postgresql://username:password@localhost:5432/compliancepulse

# Database Pool
DB_POOL_MAX=20
DB_POOL_MIN=5

# SPIFFE/SPIRE Configuration
SPIRE_SERVER_ADDRESS=unix:///tmp/spire-server/socket
SPIRE_TRUST_DOMAIN=compliancepulse.ai
SPIFFE_SVID_TTL=3600

# OPA Configuration
OPA_SERVER_URL=http://localhost:8181
OPA_POLICY_PATH=compliancepulse

# Authentication
# IMPORTANT: Use a strong random secret in production! Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRY=1h
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Audit Logging
AUDIT_ENABLED=true
GCP_PROJECT_ID=
BIGQUERY_DATASET=audit_logs
BIGQUERY_TABLE=tool_invocations

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_if_redis_auth_enabled

# Agent Configuration
MAX_CONCURRENT_AGENTS=10
AGENT_DEFAULT_TIMEOUT=300000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
