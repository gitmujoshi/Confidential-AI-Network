# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=***REMOVED-DB_PASSWORD***
# DB_PASSWORD moved to secrets.env

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
# JWT_SECRET moved to secrets.env
JWT_EXPIRES_IN=24h

# Keycloak Configuration
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_PORT=8443
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-frontend
# KEYCLOAK_CLIENT_SECRET moved to secrets.env
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD moved to secrets.env
KEYCLOAK_ENABLED=true
KEYCLOAK_HEALTH_URL=https://localhost:8443/realms/master

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# EMAIL_PASS moved to secrets.env
EMAIL_FROM=your-email@gmail.com

# Blockchain Configuration
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# SCITT CCF Configuration
SCITT_CCF_ENABLED=true
SCITT_CCF_URL=http://localhost:8000
SCITT_CCF_NODE_URL=http://localhost:8000
SCITT_CCF_DASHBOARD_URL=http://localhost:8082

# DID Configuration
DID_WEB_DOMAIN=localhost:3000
DID_WEB_PATH=/did.json

# DEPA Configuration
DEPA_ENABLED=true
DEPA_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Vault Configuration
VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN moved to secrets.env

# Additional Configuration (to prevent warnings)
REDIS_PORT=6379
FRONTEND_HEALTH_URL=http://localhost:3000/health
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
KEYCLOAK_DB_PORT=5433
BACKEND_PORT=5001
FRONTEND_PORT=3000