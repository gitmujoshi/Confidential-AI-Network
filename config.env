# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=postgres
# DB_PASSWORD moved to secrets.env

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
# JWT_SECRET moved to secrets.env
JWT_EXPIRES_IN=24h

# Backend Configuration
BACKEND_URL=http://localhost:5001
BACKEND_PORT=5001

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
FRONTEND_HEALTH_URL=http://localhost:3000

# Keycloak Configuration
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_PORT=8443
KEYCLOAK_DB_PORT=5434
KEYCLOAK_HEALTH_URL=https://localhost:8443/realms/master
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-frontend
# KEYCLOAK_CLIENT_SECRET moved to secrets.env
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD moved to secrets.env
KEYCLOAK_ENABLED=true

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# EMAIL_PASS moved to secrets.env
EMAIL_FROM=your-email@gmail.com

# Blockchain Configuration
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=disabled
BLOCKCHAIN_RPC_URL=disabled
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# DID Configuration
DID_WEB_DOMAIN=localhost:3000
DID_WEB_PATH=/did.json

# DEPA Configuration
DEPA_ENABLED=true
DEPA_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Vault Configuration
VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN moved to secrets.env

# Service Ports
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Additional Environment Variables
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# SCITT CCF Configuration
SCITT_CCF_ENABLED=true
SCITT_CCF_URL=http://localhost:8000
SCITT_CCF_DASHBOARD_URL=http://localhost:8082

# Global DEPA ID Configuration (Admin/Deployment Only)
# These values should be set during deployment based on the target environment
DEPLOYMENT_ID=US-EAST-PROD-001
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_JURISDICTION=US-Federal
DEPLOYMENT_DATA_RESIDENCY=US
DEPLOYMENT_REGULATORY_FRAMEWORK=SOX,FedRAMP,CCPA
DEPLOYMENT_TIMEZONE=America/New_York
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US

# Key Management Configuration
# Supported key algorithms (comma-separated)
KEY_ALGORITHMS=ECDSA-P256,RSA-2048,RSA-4096
# Default key algorithm
DEFAULT_KEY_ALGORITHM=ECDSA-P256
# Key generation settings
KEY_ID_PREFIX=KEY
KEY_EXPIRY_DAYS=365
# Encryption settings for private key storage
KEY_ENCRYPTION_ALGORITHM=aes-256-gcm
KEY_ENCRYPTION_SALT=salt
