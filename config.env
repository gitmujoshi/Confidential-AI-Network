# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=postgres
# DB_PASSWORD moved to secrets.env

# Server Configuration
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
# JWT_SECRET moved to secrets.env
JWT_EXPIRES_IN=24h

# Backend Configuration
BACKEND_URL=http://localhost:5001
BACKEND_PORT=5001

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
FRONTEND_HEALTH_URL=http://localhost:3000

# Keycloak Configuration
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_PORT=8443
KEYCLOAK_DB_PORT=5434
KEYCLOAK_HEALTH_URL=https://localhost:8443/realms/master
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-frontend
# KEYCLOAK_CLIENT_SECRET moved to secrets.env
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD moved to secrets.env
KEYCLOAK_ENABLED=true

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# EMAIL_PASS moved to secrets.env
EMAIL_FROM=your-email@gmail.com

# Blockchain Configuration
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=disabled
BLOCKCHAIN_RPC_URL=disabled
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# DID Configuration
DID_WEB_DOMAIN=localhost:3000
DID_WEB_PATH=/did.json

# DEPA Configuration
DEPA_ENABLED=true
DEPA_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Vault Configuration
VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN moved to secrets.env

# Service Ports
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Additional Environment Variables
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# SCITT CCF Configuration
SCITT_CCF_ENABLED=true
SCITT_CCF_URL=http://localhost:8000
SCITT_CCF_DASHBOARD_URL=http://localhost:8082

# Global DEPA ID Configuration (Admin/Deployment Only)
# These values should be set during deployment based on the target environment
DEPLOYMENT_ID=US-EAST-PROD-001
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_JURISDICTION=US-Federal
DEPLOYMENT_DATA_RESIDENCY=US
DEPLOYMENT_REGULATORY_FRAMEWORK=SOX,FedRAMP,CCPA
DEPLOYMENT_TIMEZONE=America/New_York
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US

# Key Management Configuration
# Supported key algorithms (comma-separated)
KEY_ALGORITHMS=ECDSA-P256,RSA-2048,RSA-4096
# Default key algorithm
DEFAULT_KEY_ALGORITHM=ECDSA-P256
# Key generation settings
KEY_ID_PREFIX=KEY
KEY_EXPIRY_DAYS=365
# Encryption settings for private key storage
KEY_ENCRYPTION_ALGORITHM=aes-256-gcm
KEY_ENCRYPTION_SALT=salt

# Test Configuration
TEST_TIMEOUT=30000

# Enhanced Encryption Configuration
# File size thresholds for encryption method selection (in bytes)
ENCRYPTION_SMALL_THRESHOLD=104857600
ENCRYPTION_MEDIUM_THRESHOLD=1073741824
ENCRYPTION_LARGE_THRESHOLD=10737418240

# Maximum file sizes for different encryption methods (in bytes)
ENCRYPTION_MEMORY_MAX_SIZE=104857600
ENCRYPTION_STREAMING_MAX_SIZE=1073741824
ENCRYPTION_LUKS_MAX_SIZE=10737418240

# LUKS Configuration
LUKS_CIPHER=aes-xts-plain64
LUKS_HASH=sha256
LUKS_KEY_SIZE=256
LUKS_PBKDF2_ITERATIONS=100000

# Encryption Service Configuration
ENCRYPTION_CHUNK_SIZE=65536
ENCRYPTION_PROGRESS_INTERVAL=1000
ENCRYPTION_TEMP_DIR=/tmp/encryption
LUKS_CONTAINER_DIR=/tmp/luks-containers

# Training Container Configuration
TRAINING_BACKEND_URL=http://localhost:5001
TRAINING_TEMP_DIR=/tmp/decrypted_data
TRAINING_LUKS_TEMP_DIR=/tmp/luks-training

# Platform Encryption Configuration
KEY_ROTATION_INTERVAL=86400000
TOKEN_EXPIRY_TIME=1h
MAX_DATA_SIZE=104857600
HSM_ENABLED=false
ATTESTATION_REQUIRED=true

# TEE Attestation Configuration
MAX_CONCURRENT_TEES=10
DEFAULT_TEE_IMAGE=confidential-ai-tee:latest
TEE_CPU_LIMIT=2
TEE_MEMORY_LIMIT=4Gi
TEE_STORAGE_LIMIT=10Gi

# Training Container Configuration
TRAINING_BASE_PATH=./local-tee

# Contract Signing Configuration
SIGNING_ALGORITHMS=ECDSA-P256,RSA-2048,RSA-4096
DEFAULT_SIGNING_ALGORITHM=ECDSA-P256
ENTERPRISE_SIGNING_ALGORITHMS=ECDSA-P256,RSA-2048,RSA-4096

# Key Management Configuration (already defined above, but ensuring consistency)
KEY_ALGORITHMS=ECDSA-P256,RSA-2048,RSA-4096
DEFAULT_KEY_ALGORITHM=ECDSA-P256
KEY_ID_PREFIX=KEY
KEY_ENCRYPTION_ALGORITHM=aes-256-gcm
KEY_ENCRYPTION_SALT=salt

# SCITT CCF Configuration
CCF_NODE_URL=http://localhost:8000
CCF_PLATFORM=virtual
CCF_API_KEY=dev-key
