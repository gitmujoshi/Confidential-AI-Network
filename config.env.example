# Environment Configuration Example
# Copy this file to config.env and update with your actual values
# Copy secrets.env to secrets.env.local and update with your actual secrets

# Database Configuration
# Application Database (***REMOVED-DB_PASSWORD***-app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=***REMOVED-DB_PASSWORD***
# DB_PASSWORD=your-app-db-password (from secrets.env.local)

# Keycloak Database (***REMOVED-DB_PASSWORD***-***REMOVED-KEYCLOAK_DB_PASSWORD***)
KEYCLOAK_DB_PORT=5433
KEYCLOAK_DB_NAME=***REMOVED-KEYCLOAK_DB_PASSWORD***
KEYCLOAK_DB_USER=***REMOVED-KEYCLOAK_DB_PASSWORD***
# KEYCLOAK_DB_PASSWORD=your-***REMOVED-KEYCLOAK_DB_PASSWORD***-db-password (from secrets.env.local)

# Server Configuration
PORT=5001
BACKEND_PORT=5001
NODE_ENV=development

# JWT Configuration
# JWT_SECRET=your-jwt-secret (from secrets.env.local)
JWT_EXPIRES_IN=24h

# Keycloak Configuration
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-frontend
# KEYCLOAK_CLIENT_SECRET=your-client-secret (from secrets.env.local)
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=your-admin-password (from secrets.env.local)
KEYCLOAK_ENABLED=true

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-email-password (from secrets.env.local)
EMAIL_FROM=your-email@gmail.com

# Blockchain Configuration
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# SCITT CCF Configuration
SCITT_CCF_ENABLED=true
SCITT_CCF_URL=http://localhost:8000
SCITT_CCF_DASHBOARD_URL=http://localhost:8082

# DID Configuration
DID_WEB_DOMAIN=localhost:3000
DID_WEB_PATH=/did.json

# DEPA Configuration
DEPA_ENABLED=true
DEPA_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Vault Configuration
VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=your-vault-token (from secrets.env.local)
