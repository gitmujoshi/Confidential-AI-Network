# 🌍 Multi-Deployment Configuration Examples
# 
# This file contains example configurations for different deployment scenarios.
# Copy the relevant section to your config.env file based on your deployment location.

# =============================================================================
# LOCAL DEVELOPMENT (Default)
# =============================================================================
# Use this for local development and testing

# Backend (backend/config.env)
DEPLOYMENT_ID=LOCAL
DEPLOYMENT_PREFIX=LOCAL
DEPLOYMENT_REGION=local
DEPLOYMENT_COUNTRY=Unknown
DEPLOYMENT_JURISDICTION=LOCAL
DEPLOYMENT_DATA_RESIDENCY=LOCAL
DEPLOYMENT_REGULATORY_FRAMEWORK=
DEPLOYMENT_TIMEZONE=UTC
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US

# Frontend (.env)
REACT_APP_DEPLOYMENT_ID=LOCAL
REACT_APP_DEPLOYMENT_PREFIX=LOCAL
REACT_APP_DEPLOYMENT_REGION=local
REACT_APP_DEPLOYMENT_COUNTRY=Unknown
REACT_APP_DEPLOYMENT_JURISDICTION=LOCAL
REACT_APP_DEPLOYMENT_DATA_RESIDENCY=LOCAL
REACT_APP_DEPLOYMENT_REGULATORY_FRAMEWORK=
REACT_APP_DEPLOYMENT_TIMEZONE=UTC
REACT_APP_DEPLOYMENT_CURRENCY=USD
REACT_APP_DEPLOYMENT_LANGUAGE=en-US

# =============================================================================
# US EAST COAST (AWS us-east-1)
# =============================================================================
# Use this for US East Coast deployment with US Federal compliance

# Backend (backend/config.env)
DEPLOYMENT_ID=US-EAST
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_COUNTRY=United States
DEPLOYMENT_JURISDICTION=US-Federal
DEPLOYMENT_DATA_RESIDENCY=US
DEPLOYMENT_REGULATORY_FRAMEWORK=GDPR,CCPA,HIPAA,SOX,FedRAMP
DEPLOYMENT_TIMEZONE=America/New_York
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US

# Frontend (.env)
REACT_APP_DEPLOYMENT_ID=US-EAST
REACT_APP_DEPLOYMENT_PREFIX=US-EAST
REACT_APP_DEPLOYMENT_REGION=us-east-1
REACT_APP_DEPLOYMENT_COUNTRY=United States
REACT_APP_DEPLOYMENT_JURISDICTION=US-Federal
REACT_APP_DEPLOYMENT_DATA_RESIDENCY=US
REACT_APP_DEPLOYMENT_REGULATORY_FRAMEWORK=GDPR,CCPA,HIPAA,SOX,FedRAMP
REACT_APP_DEPLOYMENT_TIMEZONE=America/New_York
REACT_APP_DEPLOYMENT_CURRENCY=USD
REACT_APP_DEPLOYMENT_LANGUAGE=en-US

