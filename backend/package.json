{
  "name": "contract-management-backend",
  "version": "1.0.0",
  "description": "Contract Management System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup-keycloak-persistent.js && node scripts/source/sync-users-to-keycloak.js",
    "start:full": "npm run setup && npm start",
    "keycloak:setup": "node setup-keycloak-persistent.js",
    "keycloak:sync": "node scripts/source/sync-users-to-keycloak.js",
    "keycloak:cleanup-orphans": "node scripts/source/cleanup-orphaned-keycloak-users.js",
    "keycloak:cleanup-orphans:execute": "node scripts/source/cleanup-orphaned-keycloak-users.js --execute",
    "keycloak:resync": "node scripts/source/cleanup-orphaned-keycloak-users.js --execute && node scripts/source/sync-users-to-keycloak.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:integration:contracts": "jest --config=jest.contracts.integration.config.js --runInBand --forceExit",
    "test:role-crud": "npm run test:role-crud:unit && npm run test:role-crud:integration",
    "test:role-crud:unit": "jest --config=jest.unit.config.js --testPathPattern=role-crud.unit",
    "test:role-crud:integration": "jest --config=jest.role-crud.config.js --runInBand --forceExit",
    "test:unit:watch": "jest --config=jest.unit.config.js --watch",
    "test:integration:watch": "jest --config=jest.integration.config.js --watch",
    "test:unit:coverage": "jest --config=jest.unit.config.js --coverage",
    "test:integration:coverage": "jest --config=jest.integration.config.js --coverage",
    "test:signing": "node tests/run-signing-tests.js",
    "test:signing:unit": "node tests/run-signing-tests.js --category unit",
    "test:signing:integration": "node tests/run-signing-tests.js --category integration",
    "test:signing:scitt": "node tests/run-signing-tests.js --category scitt",
    "test:signing:coverage": "node tests/run-signing-tests.js --coverage",
    "test:auth": "node test-keycloak-auth.js",
    "health": "curl -s http://localhost:5001/health",
    "test:login": "curl -X POST http://localhost:5001/api/auth/login -H 'Content-Type: application/json' -d '{\"email\":\"tdc-test@example.com\",\"password\":\"password123\"}'",
    "reset:keycloak": "docker-compose -f ../docker-compose.keycloak-persistent.yml down && docker-compose -f ../docker-compose.keycloak-persistent.yml up -d && sleep 10 && npm run setup",
    "status": "echo '=== Service Status ===' && curl -s http://localhost:8080/health > /dev/null && echo '✅ Keycloak: Running' || echo '❌ Keycloak: Not running' && curl -s http://localhost:5001/health > /dev/null && echo '✅ Backend: Running' || echo '❌ Backend: Not running' && curl -s http://localhost:3000 > /dev/null && echo '✅ Frontend: Running' || echo '❌ Frontend: Not running'",
    "db:ensure-training-metadata": "node scripts/ensure-training-jobs-metadata.js",
    "db:migrate:test": "sequelize-cli db:migrate --config ./config/database.test.js --env test",
    "db:reset:test": "node scripts/reset-test-database.js",
    "migrate": "npm run db:reset:test",
    "migrate:test": "npm run db:reset:test",
    "seed:e2e-users": "node create-e2e-users-direct.js",
    "seed:demo-catalog": "node scripts/dev/seed-demo-catalog.js",
    "db:purge-local-depa-reseed": "node scripts/dev/purge-local-depa-reseed.js",
    "db:purge-local-depa-reseed:dry": "node scripts/dev/purge-local-depa-reseed.js --dry-run",
    "db:purge-legacy-depa-reseed": "node scripts/dev/purge-legacy-depa-reseed.js",
    "db:purge-legacy-depa-reseed:dry": "node scripts/dev/purge-legacy-depa-reseed.js --dry-run"
  },
  "dependencies": {
    "@contract-management/value-objects": "file:../shared/valueObjects",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "keycloak-connect": "^23.0.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-vault": "^0.9.22",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "uuid": "^11.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "contract-management",
    "blockchain",
    "did",
    "keycloak",
    "authentication"
  ],
  "author": "Contract Management Team",
  "license": "MIT"
}
