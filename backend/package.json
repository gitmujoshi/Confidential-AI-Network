{
  "name": "contract-management-backend",
  "version": "1.0.0",
  "description": "Backend API for smart contract management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/run-tests.js",
    "test:mock": "node tests/run-tests.js mock",
    "test:integration": "node tests/run-tests.js integration",
    "test:services": "node tests/run-tests.js services",
    "test:all": "node tests/run-tests.js all",
    "test:runner": "node tests/run-tests.js",
    "test:runner:mock": "node tests/run-tests.js mock",
    "test:runner:integration": "node tests/run-tests.js integration",
    "test:coverage": "jest --coverage --coverageDirectory=./coverage --coverageReporters=text,html,lcov",
    "test:watch": "jest --watch",
    "test:report": "jest --reporters=default --reporters=jest-junit",
    "test:html": "jest --reporters=default --reporters=jest-html-reporter",
    "test:models": "jest tests/models.test.js",
    "test:api": "jest tests/api.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "test:multi-tdp": "jest tests/multi-tdp-contracts.test.js --verbose --detectOpenHandles",
    "test:multi-tdp:runner": "node test-multi-tdp-runner.js",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "setup-db": "node scripts/setupDatabase.js",
    "seed-data": "node scripts/seedData.js",
    "create-wallets": "node scripts/createTestWallets.js",
    "register-hardhat": "node scripts/registerHardhatUsers.js",
    "create-datasets": "node scripts/createTestDatasets.js",
    "migrate-iam": "node scripts/migrateIAMFields.js",
    "setup-***REMOVED-KEYCLOAK_DB_PASSWORD***": "node scripts/setupKeycloak.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "***REMOVED-KEYCLOAK_DB_PASSWORD***-connect": "^23.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.1",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "axios": "^1.10.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.3.0",
    "jest-sonar-reporter": "^2.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  }
}
