  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set variables from responses",
          "if (pm.response && pm.response.json()) {",
          "    const response = pm.response.json();",
          "    ",
          "    // Set auth token from login response",
          "    if (response.token) {",
          "        pm.collectionVariables.set('auth_token', response.token);",
          "    }",
          "    ",
          "    // Set user ID from profile response",
          "    if (response.id) {",
          "        pm.collectionVariables.set('user_id', response.id);",
          "    }",
          "    ",
          "    // Set contract ID from contract creation response",
          "    if (response.contract && response.contract.id) {",
          "        pm.collectionVariables.set('contract_id', response.contract.id);",
          "    }",
          "    ",
          "    // Set environment ID from environment creation response",
          "    if (response.environment && response.environment.id) {",
          "        pm.collectionVariables.set('environment_id', response.environment.id);",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response has required fields', function () {",
          "    const response = pm.response.json();",
          "    pm.expect(response).to.have.property('success');",
          "});",
          "",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ]
