      "recitals": [
        "Provider owns and controls the Customer Behavior Dataset 2024 (DS-2024-001)",
        "Consumer desires to train a Customer Churn Prediction Model using said dataset",
        "Reviewer will provide a secure environment for data processing and model training",
        "All parties agree to comply with applicable data protection regulations"
      ],
      "terms": [
        {
          "section": "1.0",
          "title": "Data Provision",
          "content": "Provider agrees to provide the Customer Behavior Dataset 2024 (DS-2024-001) to Consumer for the purpose of training a Customer Churn Prediction Model. The dataset contains anonymized customer behavior patterns, purchase history, and demographic information."
        },
        {
          "section": "2.0",
          "title": "Payment Terms",
          "content": "Consumer agrees to pay Provider the sum of $10,000 USD (Ten Thousand United States Dollars) for the dataset and associated services. Payment shall be made upfront upon contract activation."
        },
        {
          "section": "3.0",
          "title": "Secure Environment",
          "content": "Reviewer shall provide a secure, isolated environment for data processing and model training. The environment shall include encryption at rest and in transit, access controls, and comprehensive audit logging."
        },
        {
          "section": "4.0",
          "title": "Data Retention",
          "content": "All data shall be retained for a maximum of 90 days from the date of contract completion, after which it shall be securely deleted in accordance with DPDP Act 2023 requirements."
        },
        {
          "section": "5.0",
          "title": "Compliance",
          "content": "All parties agree to comply with the Digital Personal Data Protection Act 2023, GDPR, and ISO 27001 security standards. Any breach of compliance requirements shall result in immediate contract termination."
        },
        {
          "section": "6.0",
          "title": "Intellectual Property",
          "content": "Consumer may use the trained model for commercial purposes but may not redistribute the original dataset. Provider retains ownership of the original dataset."
        }
