# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=mukeshjoshi
DB_PASSWORD=

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Blockchain Configuration
BLOCKCHAIN_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_ENABLED=false

# Email Configuration (for notifications)
# Set to 'true' to enable actual email sending, 'false' to log emails only
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=test@example.com
EMAIL_PASS=test-password

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Enterprise DID Configuration
# Comma-separated list of allowed domains for did:web (empty = no restrictions)
ALLOWED_DID_WEB_DOMAINS=
# Require HTTPS for did:web resolution (true/false)
REQUIRE_HTTPS=true
# Maximum redirects for did:web resolution
MAX_DID_REDIRECTS=3
# Timeout for DID resolution in milliseconds
DID_RESOLUTION_TIMEOUT=10000

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-backend
KEYCLOAK_CLIENT_SECRET=backend-secret-key-123
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=***REMOVED-KEYCLOAK_ADMIN_PASSWORD*** 