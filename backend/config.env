# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_management
DB_USER=mukeshjoshi
DB_PASSWORD=

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Blockchain Configuration
BLOCKCHAIN_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=0xd118205512ab2f40c3b5512c46299ba0151c3e0b9c47bdf996d6253d1895192a

# Email Configuration (for notifications)
# Set to 'true' to enable actual email sending, 'false' to log emails only
EMAIL_ENABLED=true
EMAIL_HOST=localhost
EMAIL_PORT=8025
EMAIL_USER=
EMAIL_PASS=

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Enterprise DID Configuration
# Comma-separated list of allowed domains for did:web (empty = no restrictions)
ALLOWED_DID_WEB_DOMAINS=
# Require HTTPS for did:web resolution (true/false)
REQUIRE_HTTPS=true
# Maximum redirects for did:web resolution
MAX_DID_REDIRECTS=3
# Timeout for DID resolution in milliseconds
DID_RESOLUTION_TIMEOUT=10000

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=contract-management
KEYCLOAK_CLIENT_ID=contract-management-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=***REMOVED-KEYCLOAK_ADMIN_PASSWORD***
KEYCLOAK_ENABLED=true

# Multi-Deployment Configuration
DEPLOYMENT_ID=LOCAL
DEPLOYMENT_PREFIX=LOCAL
DEPLOYMENT_REGION=local
DEPLOYMENT_COUNTRY=Unknown
DEPLOYMENT_JURISDICTION=LOCAL
DEPLOYMENT_DATA_RESIDENCY=LOCAL
DEPLOYMENT_REGULATORY_FRAMEWORK=
DEPLOYMENT_TIMEZONE=UTC
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US