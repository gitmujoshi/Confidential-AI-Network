async function getAdminToken() {
  try {
    console.log('🔑 Getting admin token...');
    const response = await axios.post(
      `${CONFIG.***REMOVED-KEYCLOAK_DB_PASSWORD***Url}/realms/master/protocol/openid-connect/token`,
      `grant_type=password&client_id=admin-cli&username=${CONFIG.adminUsername}&password=${CONFIG.adminPassword}`,
      {
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        httpsAgent: httpsAgent
      }
    );
    console.log('✅ Admin token retrieved successfully');
    return response.data.access_token;
  } catch (error) {
    console.error('❌ Failed to get admin token:', error.response?.data || error.message);
    throw error;
  }
}

async function setUserPassword(***REMOVED-KEYCLOAK_DB_PASSWORD***UserId, password, adminToken) {
  try {
    console.log(`   🔐 Setting password for user ${***REMOVED-KEYCLOAK_DB_PASSWORD***UserId}...`);
    const response = await axios.put(
      `${CONFIG.***REMOVED-KEYCLOAK_DB_PASSWORD***Url}/admin/realms/${CONFIG.***REMOVED-KEYCLOAK_DB_PASSWORD***Realm}/users/${***REMOVED-KEYCLOAK_DB_PASSWORD***UserId}/reset-password`,
      {
        type: 'password',
        value: password,
        temporary: false
      },
      {
        headers: {
          'Authorization': `Bearer ${adminToken}`,
          'Content-Type': 'application/json'
        },
        httpsAgent: httpsAgent
      }
    );
    console.log(`   ✅ Password set successfully for user ${***REMOVED-KEYCLOAK_DB_PASSWORD***UserId}`);
    return true;
  } catch (error) {
    console.error(`   ❌ Failed to set password for user ${***REMOVED-KEYCLOAK_DB_PASSWORD***UserId}:`, error.response?.data || error.message);
    return false;
  }
}

async function createDatabaseUser(userData) {
  try {
    console.log(`   🗄️ Creating database user for ${userData.email}...`);
    
    // Generate DEPA ID
    const DEPAIdService = require('../services/depaIdService');
    const depaIdService = new DEPAIdService();
    const depaId = depaIdService.generateUserDEPAId(userData.partyType);
    
    // Generate DID
    const domain = userData.email.split('@')[1] || 'example.com';
    const did = `did:web:${domain}:user:${userData.email.split('@')[0]}`;
    
    const dbUser = await User.create({
      walletAddress: null, // Enterprise users don't have wallet addresses
      publicKey: null,
      partyType: userData.partyType,
      name: userData.name,
      email: userData.email.toLowerCase(),
      description: userData.description || '',
      organization: userData.organization || '',
      phoneNumber: null,
      website: null,
      location: null,
      did: did,
      didSource: 'SYSTEM_GENERATED',
      didVerified: true,
      didVerificationMethod: 'SYSTEM_GENERATED',
      onboardingStatus: 'IN_PROGRESS',
      profileCompleted: false,
      emailVerified: false,
      isRegistered: true,
      registrationDate: new Date(),
      isActive: true,
      iamUserId: userData.***REMOVED-KEYCLOAK_DB_PASSWORD***Id,
      iamUsername: userData.email,
      depaId: depaId
    });
    
    console.log(`   ✅ Database user created successfully with ID: ${dbUser.id}`);
    return dbUser;
  } catch (error) {
    console.error(`   ❌ Failed to create database user for ${userData.email}:`, error.message);
    throw error;
  }
}

async function testUserLogin(email) {
  try {
    console.log(`   🔐 Testing login for ${email}...`);
    const response = await axios.post(
      `${CONFIG.backendUrl}/api/auth/login`,
      {
        email: email,
        password: 'password123'
      },
      {
        headers: { 'Content-Type': 'application/json' },
        timeout: 10000
      }
    );
    
    if (response.data.accessToken) {
      console.log(`   ✅ Login successful for ${email}`);
      return true;
    } else {
      console.log(`   ❌ Login failed for ${email}: No access token`);
      return false;
    }
  } catch (error) {
    console.error(`   ❌ Login failed for ${email}:`, error.response?.data || error.message);
    return false;
  }
}

async function main() {
  console.log('🚀 Starting User Synchronization Fix...\n');
  
  try {
    // Get admin token
    const adminToken = await getAdminToken();
    
    let successCount = 0;
    let failCount = 0;
    
    // Process each user
    for (const userData of testUsers) {
      console.log(`\n👤 Processing user: ${userData.email}`);
      
      try {
        // Set password in Keycloak
        const passwordSet = await setUserPassword(userData.***REMOVED-KEYCLOAK_DB_PASSWORD***Id, 'password123', adminToken);
        
        if (passwordSet) {
          // Create database user
          await createDatabaseUser(userData);
          
          // Test login
          const loginSuccess = await testUserLogin(userData.email);
          
          if (loginSuccess) {
            successCount++;
            console.log(`   ✅ User ${userData.email} fully synchronized and working`);
          } else {
            failCount++;
            console.log(`   ❌ User ${userData.email} created but login failed`);
          }
        } else {
          failCount++;
          console.log(`   ❌ Failed to set password for ${userData.email}`);
        }
      } catch (error) {
        failCount++;
        console.error(`   ❌ Error processing user ${userData.email}:`, error.message);
      }
    }
    
    console.log('\n📊 User Synchronization Summary:');
    console.log('================================');
    console.log(`✅ Successfully synchronized: ${successCount}/${testUsers.length}`);
    console.log(`❌ Failed: ${failCount}/${testUsers.length}`);
    
    if (successCount > 0) {
      console.log('\n🎉 Some users are now working!');
      console.log('💡 Test with password: password123');
    }
    
  } catch (error) {
    console.error('\n❌ Script failed:', error.message);
    process.exit(1);
  }
}

if (require.main === module) {
  main();
}

module.exports = { fixUserSync: main };
