# =============================================================================
# GCP deployment — environment template (TARGET)
# =============================================================================
# Full feature docs: docs/deployment/GCP_FEATURES_AND_CONFIGURATION.md
# Laptop demos: keep config.env + Keycloak — do NOT set AUTH_PROVIDER=gcp-identity
# for local Playwright unless testing Identity Platform.
# =============================================================================

# --- Identity (GCP = Identity Platform; Keycloak local only) -----------------
AUTH_PROVIDER=gcp-identity
KEYCLOAK_ENABLED=false

GCP_PROJECT_ID=can-dev-123456
GCP_IDENTITY_AUTH_DOMAIN=can-dev-123456.firebaseapp.com
# GCP_IDENTITY_API_KEY=         # web API key (client-side)
GCP_OIDC_CLIENT_ID=
# GCP_OIDC_CLIENT_SECRET=       # backend only — never commit
GCP_OIDC_ISSUER=https://securetoken.google.com/can-dev-123456
GCP_OIDC_AUDIENCE=can-dev-123456
GCP_IDENTITY_REDIRECT_URI=https://app.dev.example.com/login
GCP_USE_IDENTITY_PLATFORM_TOKENS=true
GCP_ROLE_CLAIM=roles
GCP_IAP_ENABLED=false

# --- Platform GCP / Workload Identity ----------------------------------------
GCP_REGION=us-central1
GCP_USE_WORKLOAD_IDENTITY=true
# GOOGLE_APPLICATION_CREDENTIALS=   # local/dev only; avoid on GKE

# --- Secret Manager / Cloud KMS ----------------------------------------------
SECRET_BACKEND=gcp-secrets
GCP_SECRET_PREFIX=can-dev-
GCP_KMS_KEY_NAME=projects/can-dev-123456/locations/us-central1/keyRings/can-dev/cryptoKeys/platform
GCP_GCS_KMS_KEY_NAME=projects/can-dev-123456/locations/us-central1/keyRings/can-dev/cryptoKeys/gcs

# --- Signing keys ------------------------------------------------------------
SIGNING_KEY_BACKEND=database
# SIGNING_KEY_BACKEND=gcp-kms
# SIGNING_KMS_KEY_NAME=projects/.../cryptoKeys/signing
SIGNING_REQUIRE_CRYPTO_VERIFY=false
SIGNING_REQUIRE_DID_VERIFY=false
SIGNING_DEFAULT_ALGORITHM=ECDSA_P256

# --- DEK / MEK / CAN ---------------------------------------------------------
CAN_PRINCIPAL_KEY_MODE=signals
CAN_ESCROW_TIMEOUT_MS=600000
CAN_ATTESTATION_PROVIDER=simulated
# CAN_ATTESTATION_PROVIDER=gcp-confidential-space
CAN_REJECT_KEY_MATERIAL_ON_API=true
PLATFORM_ENCRYPTION_MODE=demo

# --- Contract KMS ------------------------------------------------------------
CONTRACT_KMS_ENFORCE=false
CONTRACT_KMS_ALLOWED_PROVIDERS=gcp-kms

# --- GCS ---------------------------------------------------------------------
DATASET_STORAGE_BACKEND=gcp-gcs
GCP_GCS_BUCKET_DATASETS=can-dev-datasets
GCP_GCS_BUCKET_OUTPUTS=can-dev-training-outputs
GCP_GCS_BUCKET_ARTIFACTS=can-dev-artifacts

# --- Training / inference ----------------------------------------------------
TRAINING_EXECUTION_MODE=gcp
TRAINING_SIMULATION_MODE=false
GCP_TRAINING_COMPUTE=gke-job
# GCP_TRAINING_COMPUTE=confidential-space
LOCAL_TRAINING_IMAGE=us-central1-docker.pkg.dev/can-dev-123456/can/local-trainer:latest
INFERENCE_EXECUTION_MODE=gke-job
INFERENCE_TIMEOUT_MS=600000

# --- SCITT -------------------------------------------------------------------
SCITT_CCF_ENABLED=false
# SCITT_CCF_URL=https://scitt.dev.example.com
SCITT_CCF_TIMEOUT=5000
# SCITT_DEPLOYMENT=gke

# --- Deployment metadata (DEPA) ----------------------------------------------
DEPLOYMENT_ID=US-CENTRAL-GCP-DEV-001
DEPLOYMENT_PREFIX=US-CENTRAL
DEPLOYMENT_REGION=us-central1
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US
DEPLOYMENT_TIMEZONE=America/Chicago

# --- E2E against GCP staging -------------------------------------------------
# E2E_AUTH_PROVIDER=gcp-identity
# PLAYWRIGHT_BASE_URL=https://app.staging.example.com
# BACKEND_URL=https://api.staging.example.com
