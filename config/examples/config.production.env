# Production Configuration for AI Model Training Environment
# This file contains production environment variables

# Environment
NODE_ENV=production
TEE_MODE=cloud
ENVIRONMENT=production

# Database Configuration
DB_HOST=postgresql.production.svc.cluster.local
DB_PORT=5432
DB_NAME=contract_management_production
DB_USER=postgres
DB_PASSWORD=${DB_PASSWORD}
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Configuration
REDIS_HOST=redis.production.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=https://training.example.com
API_RATE_LIMIT=1000
API_TIMEOUT=30000

# Authentication & Authorization
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=production
KEYCLOAK_CLIENT_ID=contract-management
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=24h

# Cloud Provider Configuration
CLOUD_PROVIDER=aws
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_S3_BUCKET=ai-training-data
AWS_KMS_KEY_ID=${AWS_KMS_KEY_ID}

# TEE Configuration
TEE_PROVIDER=aws
TEE_REGION=us-east-1
TEE_INSTANCE_TYPE=m5.large
TEE_IMAGE_ID=ami-12345678
TEE_SECURITY_GROUP=sg-12345678
TEE_SUBNET_ID=subnet-12345678

# Training Environment Configuration
TRAINING_MODE=cloud
TRAINING_BASE_PATH=/opt/training
TRAINING_CONTAINER_IMAGE=ai-training:latest
TRAINING_DOCKER_REGISTRY=registry.example.com
TRAINING_RESOURCE_LIMITS_CPU=4
TRAINING_RESOURCE_LIMITS_MEMORY=8Gi
TRAINING_RESOURCE_LIMITS_GPU=1

# Monitoring Configuration
MONITORING_ENABLED=true
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
ELASTICSEARCH_URL=http://elasticsearch.logging.svc.cluster.local:9200
KIBANA_URL=http://kibana.logging.svc.cluster.local:5601

# Security Configuration
VAULT_URL=https://vault.example.com
VAULT_TOKEN=${VAULT_TOKEN}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
SIGNING_KEY=${SIGNING_KEY}
ATTESTATION_KEY=${ATTESTATION_KEY}

# Privacy Configuration
PRIVACY_ENABLED=true
DIFFERENTIAL_PRIVACY_EPSILON=1.0
DIFFERENTIAL_PRIVACY_DELTA=1e-5
PRIVACY_BUDGET_MAX=10.0
DATA_ANONYMIZATION_ENABLED=true

# Provenance Configuration
PROVENANCE_ENABLED=true
PROVENANCE_STORAGE_TYPE=s3
PROVENANCE_STORAGE_BUCKET=ai-training-provenance
PROVENANCE_MERKLE_TREE_ENABLED=true
PROVENANCE_DIGITAL_SIGNATURES_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/training
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_COMPRESS=true

# Performance Configuration
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_METRICS_INTERVAL=30s
PERFORMANCE_ALERT_THRESHOLD_CPU=80
PERFORMANCE_ALERT_THRESHOLD_MEMORY=90
PERFORMANCE_ALERT_THRESHOLD_DISK=90

# Compliance Configuration
COMPLIANCE_GDPR_ENABLED=true
COMPLIANCE_HIPAA_ENABLED=false
COMPLIANCE_SOX_ENABLED=false
COMPLIANCE_AI_ACT_ENABLED=true
AUDIT_LOGGING_ENABLED=true
AUDIT_RETENTION_DAYS=2555

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=s3
BACKUP_STORAGE_BUCKET=ai-training-backups

# Scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_REPLICAS=2
MAX_REPLICAS=10
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80

# Network Configuration
INGRESS_CLASS=nginx
INGRESS_TLS_ENABLED=true
INGRESS_TLS_SECRET=training-tls
SERVICE_MESH_ENABLED=false

# Storage Configuration
STORAGE_CLASS=gp3
STORAGE_SIZE=100Gi
STORAGE_ENCRYPTION_ENABLED=true
STORAGE_BACKUP_ENABLED=true

# External Services
BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/${INFURA_PROJECT_ID}
BLOCKCHAIN_PRIVATE_KEY=${BLOCKCHAIN_PRIVATE_KEY}
SCITT_CCF_URL=https://scitt-ccf.example.com
SCITT_CCF_API_KEY=${SCITT_CCF_API_KEY}

# Feature Flags
FEATURE_FEDERATED_LEARNING=true
FEATURE_DIFFERENTIAL_PRIVACY=true
FEATURE_SECURE_AGGREGATION=true
FEATURE_CROSS_CLOUD_VERIFICATION=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_AUTOMATED_SCALING=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_PATH=/health

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
METRICS_INTERVAL=15s

# Alerting Configuration
ALERTING_ENABLED=true
ALERT_MANAGER_URL=http://alertmanager.monitoring.svc.cluster.local:9093
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=${EMAIL_SMTP_USER}
EMAIL_SMTP_PASSWORD=${EMAIL_SMTP_PASSWORD}

# Development/Testing
DEBUG_MODE=false
MOCK_SERVICES=false
TEST_MODE=false
