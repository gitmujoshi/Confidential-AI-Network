# =============================================================================
# Azure deployment — environment template (TARGET)
# =============================================================================
# Copy relevant vars into the environment / Key Vault secrets for can-{env}.
# Local docker-compose demos should continue using config.env + Keycloak —
# do NOT set AUTH_PROVIDER=entra for laptop E2E unless you are testing MSAL.
#
# Full feature docs: docs/deployment/AZURE_FEATURES_AND_CONFIGURATION.md
# =============================================================================

# --- Identity (Azure = Entra only) -------------------------------------------
AUTH_PROVIDER=entra
KEYCLOAK_ENABLED=false

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=api://can-dev-api
ENTRA_AUTHORITY=https://login.microsoftonline.com/
# ENTRA_CLIENT_SECRET=          # Key Vault only — never commit
ENTRA_REDIRECT_URI=https://app.dev.example.com
ENTRA_ROLE_CLAIM=roles

# --- Platform Azure / MSI ----------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_USE_MANAGED_IDENTITY=true
# AZURE_CLIENT_ID=              # user-assigned MSI (optional)
# AZURE_CLIENT_SECRET=          # only if not using MSI
AZURE_DEFAULT_LOCATION=eastus

# --- Key Vault (platform secrets & CMK) --------------------------------------
AZURE_KEY_VAULT_URL=https://can-dev-kv.vault.azure.net/
AZURE_KEY_VAULT_NAME=can-dev-kv
SECRET_BACKEND=azure-keyvault
# AZURE_STORAGE_CMK_KEY_ID=
# AZURE_POSTGRES_CMK_KEY_ID=

# --- Signing keys ------------------------------------------------------------
SIGNING_KEY_BACKEND=database
# SIGNING_KEY_BACKEND=azure-keyvault   # Phase 2+
# SIGNING_KEY_VAULT_URL=https://can-dev-kv.vault.azure.net/
SIGNING_REQUIRE_CRYPTO_VERIFY=false
SIGNING_REQUIRE_DID_VERIFY=false
SIGNING_DEFAULT_ALGORITHM=ECDSA_P256

# --- DEK / MEK / CAN ---------------------------------------------------------
CAN_PRINCIPAL_KEY_MODE=signals
# CAN_PRINCIPAL_KEY_MODE=attested-tls  # prod target
CAN_ESCROW_TIMEOUT_MS=600000
CAN_ATTESTATION_PROVIDER=simulated
# CAN_ATTESTATION_PROVIDER=azure-attestation
# AZURE_ATTESTATION_URL=
CAN_REJECT_KEY_MATERIAL_ON_API=true
PLATFORM_ENCRYPTION_MODE=demo
# PLATFORM_ENCRYPTION_MODE=disabled    # CAN prod

# --- Contract KMS ------------------------------------------------------------
CONTRACT_KMS_ENFORCE=false
CONTRACT_KMS_ALLOWED_PROVIDERS=azure-key-vault

# --- Storage -----------------------------------------------------------------
DATASET_STORAGE_BACKEND=azure-blob
AZURE_STORAGE_ACCOUNT=candevdata
AZURE_STORAGE_BLOB_ENDPOINT=https://candevdata.blob.core.windows.net
AZURE_STORAGE_DATASETS_CONTAINER=can-dev-datasets
AZURE_STORAGE_OUTPUTS_CONTAINER=can-dev-training-outputs
AZURE_STORAGE_ARTIFACTS_CONTAINER=can-dev-artifacts
# AZURE_STORAGE_CONNECTION_STRING=     # prefer MSI over connection string

# --- Training / inference ----------------------------------------------------
TRAINING_EXECUTION_MODE=azure
TRAINING_SIMULATION_MODE=false
AZURE_TRAINING_COMPUTE=aci
# AZURE_TRAINING_COMPUTE=aks-job
# AZURE_TRAINING_COMPUTE=dcsv3
AZURE_ACI_CPU=2
AZURE_ACI_MEMORY_GB=8
AZURE_CONFIDENTIAL_VM_SIZE=Standard_DC2s_v3
LOCAL_TRAINING_IMAGE=candevacr.azurecr.io/local-trainer:latest
INFERENCE_EXECUTION_MODE=aks-job
INFERENCE_TIMEOUT_MS=600000

# --- SCITT (optional until Azure CCF is stood up) ----------------------------
SCITT_CCF_ENABLED=false
# SCITT_CCF_URL=https://scitt.dev.example.com
# SCITT_CCF_DASHBOARD_URL=
SCITT_CCF_TIMEOUT=5000
# SCITT_DEPLOYMENT=aks

# --- Deployment metadata (DEPA) ----------------------------------------------
DEPLOYMENT_ID=US-EAST-AZURE-DEV-001
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=eastus
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_JURISDICTION=US-Federal
DEPLOYMENT_DATA_RESIDENCY=US
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US
DEPLOYMENT_TIMEZONE=America/New_York

# --- E2E against Azure staging (CI) ------------------------------------------
# E2E_AUTH_PROVIDER=entra
# PLAYWRIGHT_BASE_URL=https://app.staging.example.com
# BACKEND_URL=https://api.staging.example.com
