# =============================================================================
# OCI deployment — environment template (TARGET)
# =============================================================================
# Full feature docs: docs/deployment/OCI_FEATURES_AND_CONFIGURATION.md
# Laptop demos: keep config.env + Keycloak docker-compose —
# do NOT set AUTH_PROVIDER=oci-iam for local Playwright unless testing OCI IAM.
# =============================================================================

# --- Identity (OCI = IAM Identity Domains only; Keycloak local only) ---------
AUTH_PROVIDER=oci-iam
KEYCLOAK_ENABLED=false

OCI_IDENTITY_DOMAIN_URL=https://idcs-XXXX.identity.oraclecloud.com
OCI_IDENTITY_CLIENT_ID=
OCI_IDENTITY_API_CLIENT_ID=
OCI_IDENTITY_ISSUER=
OCI_IDENTITY_AUDIENCE=
# OCI_IDENTITY_JWKS_URL=
OCI_IDENTITY_ROLE_CLAIM=groups
OCI_CLOUD_GATE_ENABLED=true

OCI_TENANCY_OCID=ocid1.tenancy.oc1..
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..
OCI_REGION=us-ashburn-1
OCI_AUTH_MODE=instance_principal

# --- Vault -------------------------------------------------------------------
SECRET_BACKEND=oci-vault
OCI_VAULT_OCID=ocid1.vault.oc1..
OCI_VAULT_KEY_OCID=ocid1.key.oc1..
OCI_VAULT_COMPARTMENT_OCID=ocid1.compartment.oc1..

# --- Signing keys ------------------------------------------------------------
SIGNING_KEY_BACKEND=database
# SIGNING_KEY_BACKEND=oci-vault
# SIGNING_KEY_VAULT_OCID=ocid1.vault.oc1..
SIGNING_REQUIRE_CRYPTO_VERIFY=false
SIGNING_REQUIRE_DID_VERIFY=false
SIGNING_DEFAULT_ALGORITHM=ECDSA_P256

# --- DEK / MEK / CAN ---------------------------------------------------------
CAN_PRINCIPAL_KEY_MODE=signals
CAN_ESCROW_TIMEOUT_MS=600000
CAN_ATTESTATION_PROVIDER=simulated
# CAN_ATTESTATION_PROVIDER=oci-attestation
CAN_REJECT_KEY_MATERIAL_ON_API=true
PLATFORM_ENCRYPTION_MODE=demo

# --- Contract KMS ------------------------------------------------------------
CONTRACT_KMS_ENFORCE=false
CONTRACT_KMS_ALLOWED_PROVIDERS=oci-vault

# --- Object Storage ----------------------------------------------------------
DATASET_STORAGE_BACKEND=oci-object
OCI_NAMESPACE=
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET_DATASETS=cms-dev-datasets
OCI_OBJECT_STORAGE_BUCKET_OUTPUTS=cms-dev-training-outputs
OCI_OBJECT_STORAGE_BUCKET_ARTIFACTS=cms-dev-artifacts

# --- Training / inference ----------------------------------------------------
TRAINING_EXECUTION_MODE=oci
TRAINING_SIMULATION_MODE=false
OCI_TRAINING_COMPUTE=oke-job
# OCI_TRAINING_COMPUTE=confidential
LOCAL_TRAINING_IMAGE=iad.ocir.io/NAMESPACE/local-trainer:latest
INFERENCE_EXECUTION_MODE=oke-job
INFERENCE_TIMEOUT_MS=600000

# --- SCITT -------------------------------------------------------------------
SCITT_CCF_ENABLED=false
# SCITT_CCF_URL=https://scitt.dev.example.com
SCITT_CCF_TIMEOUT=5000
# SCITT_DEPLOYMENT=oke

# --- Deployment metadata (DEPA) ----------------------------------------------
DEPLOYMENT_ID=US-EAST-OCI-DEV-001
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=us-ashburn-1
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US
DEPLOYMENT_TIMEZONE=America/New_York

# --- E2E against OCI staging -------------------------------------------------
# E2E_AUTH_PROVIDER=oci-iam
# PLAYWRIGHT_BASE_URL=https://app.staging.example.com
# BACKEND_URL=https://api.staging.example.com
