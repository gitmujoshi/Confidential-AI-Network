# SCITT CCF Environment Configuration
# Copy this file to .env.scitt-ccf and modify as needed

# Migration Mode: ETHEREUM_ONLY, SCITT_CCF_ONLY, or HYBRID
MIGRATION_MODE=SCITT_CCF_ONLY

# SCITT CCF Node Configuration
CCF_NODE_URL=http://scitt-ccf-node-dev:8000
CCF_PLATFORM=virtual

# TEE Provider Configuration
TEE_PROVIDER=virtual
TEE_CAPABILITIES=encryption,isolation

# Performance Settings
CCF_TIMEOUT=10000
CCF_HEALTH_CHECK_INTERVAL=30000

# Database Configuration for SCITT CCF
SCITT_DB_HOST=scitt-ccf-postgres-dev
SCITT_DB_PORT=5432
SCITT_DB_NAME=scitt_ccf_dev
SCITT_DB_USER=scitt_user
SCITT_DB_PASSWORD=scitt_pass

# Redis Configuration for SCITT CCF
SCITT_REDIS_HOST=scitt-ccf-redis-dev
SCITT_REDIS_PORT=6379

# Monitoring Configuration
SCITT_MONITOR_ENABLED=true
SCITT_MONITOR_PORT=8082

# Dashboard Configuration
SCITT_DASHBOARD_ENABLED=true
SCITT_DASHBOARD_PORT=8082
