# =============================================================================
# AWS deployment — environment template (TARGET)
# =============================================================================
# Full feature docs: docs/deployment/AWS_FEATURES_AND_CONFIGURATION.md
# Laptop demos: keep config.env + Keycloak — do NOT set AUTH_PROVIDER=cognito
# for local Playwright unless testing Cognito.
# =============================================================================

# --- Identity (AWS = Cognito; Keycloak local only) ---------------------------
AUTH_PROVIDER=cognito
KEYCLOAK_ENABLED=false

COGNITO_USER_POOL_ID=us-east-1_XXXX
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=can-dev.auth.us-east-1.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX
COGNITO_AUDIENCE=
COGNITO_ROLE_CLAIM=cognito:groups

# --- Platform AWS / IRSA -----------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_USE_IRSA=true
# AWS_ACCESS_KEY_ID=            # avoid on EKS; use IRSA
# AWS_SECRET_ACCESS_KEY=

# --- Secrets Manager / KMS ---------------------------------------------------
SECRET_BACKEND=aws-secrets
AWS_SECRETS_PREFIX=can/dev/
AWS_KMS_KEY_ID=alias/can-dev
AWS_S3_SSE_KMS_KEY_ID=alias/can-dev

# --- Signing keys ------------------------------------------------------------
SIGNING_KEY_BACKEND=database
# SIGNING_KEY_BACKEND=aws-kms
# SIGNING_KMS_KEY_ID=arn:aws:kms:...
SIGNING_REQUIRE_CRYPTO_VERIFY=false
SIGNING_REQUIRE_DID_VERIFY=false
SIGNING_DEFAULT_ALGORITHM=ECDSA_P256

# --- DEK / MEK / CAN ---------------------------------------------------------
CAN_PRINCIPAL_KEY_MODE=signals
CAN_ESCROW_TIMEOUT_MS=600000
CAN_ATTESTATION_PROVIDER=simulated
# CAN_ATTESTATION_PROVIDER=aws-nitro
CAN_REJECT_KEY_MATERIAL_ON_API=true
PLATFORM_ENCRYPTION_MODE=demo

# --- Contract KMS ------------------------------------------------------------
CONTRACT_KMS_ENFORCE=false
CONTRACT_KMS_ALLOWED_PROVIDERS=aws-kms

# --- S3 ----------------------------------------------------------------------
DATASET_STORAGE_BACKEND=aws-s3
AWS_S3_BUCKET_DATASETS=can-dev-datasets
AWS_S3_BUCKET_OUTPUTS=can-dev-training-outputs
AWS_S3_BUCKET_ARTIFACTS=can-dev-artifacts

# --- Training / inference ----------------------------------------------------
TRAINING_EXECUTION_MODE=aws
TRAINING_SIMULATION_MODE=false
AWS_TRAINING_COMPUTE=eks-job
# AWS_TRAINING_COMPUTE=nitro-enclave
LOCAL_TRAINING_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/local-trainer:latest
INFERENCE_EXECUTION_MODE=eks-job
INFERENCE_TIMEOUT_MS=600000

# --- SCITT -------------------------------------------------------------------
SCITT_CCF_ENABLED=false
# SCITT_CCF_URL=https://scitt.dev.example.com
SCITT_CCF_TIMEOUT=5000
# SCITT_DEPLOYMENT=eks

# --- Deployment metadata (DEPA) ----------------------------------------------
DEPLOYMENT_ID=US-EAST-AWS-DEV-001
DEPLOYMENT_PREFIX=US-EAST
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_COUNTRY="United States"
DEPLOYMENT_CURRENCY=USD
DEPLOYMENT_LANGUAGE=en-US
DEPLOYMENT_TIMEZONE=America/New_York

# --- E2E against AWS staging -------------------------------------------------
# E2E_AUTH_PROVIDER=cognito
# PLAYWRIGHT_BASE_URL=https://app.staging.example.com
# BACKEND_URL=https://api.staging.example.com
