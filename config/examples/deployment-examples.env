# =============================================================================
# Global DEPA ID Configuration Examples for Different Deployments
# =============================================================================
# Copy the appropriate section to your config.env based on deployment region

# =============================================================================
# UNITED STATES - FEDERAL (East Coast Production)
# =============================================================================
# DEPLOYMENT_ID=US-EAST-PROD-001
# DEPLOYMENT_PREFIX=US-EAST
# DEPLOYMENT_REGION=us-east-1
# DEPLOYMENT_COUNTRY="United States"
# DEPLOYMENT_JURISDICTION=US-Federal
# DEPLOYMENT_DATA_RESIDENCY=US
# DEPLOYMENT_REGULATORY_FRAMEWORK=SOX,FedRAMP,CCPA
# DEPLOYMENT_TIMEZONE=America/New_York
# DEPLOYMENT_CURRENCY=USD
# DEPLOYMENT_LANGUAGE=en-US

# =============================================================================
# UNITED STATES - WEST COAST (California)
# =============================================================================
# DEPLOYMENT_ID=US-WEST-PROD-001
# DEPLOYMENT_PREFIX=US-WEST
# DEPLOYMENT_REGION=us-west-2
# DEPLOYMENT_COUNTRY="United States"
# DEPLOYMENT_JURISDICTION=US-Federal
# DEPLOYMENT_DATA_RESIDENCY=US
# DEPLOYMENT_REGULATORY_FRAMEWORK=SOX,FedRAMP,CCPA
# DEPLOYMENT_TIMEZONE=America/Los_Angeles
# DEPLOYMENT_CURRENCY=USD
# DEPLOYMENT_LANGUAGE=en-US

