# Hugging Face Hub integration (development / test only)
# Copy relevant lines into config.env for local dev. Not enabled in production by default.

# Master switch — requires NODE_ENV=development or test
HUGGINGFACE_INTEGRATION_ENABLED=false

# Optional: allow in production (not recommended without Vault + policy review)
# HUGGINGFACE_ALLOW_IN_PRODUCTION=false

# Hub API base (default: https://huggingface.co)
# HUGGINGFACE_HUB_URL=https://huggingface.co

# Read token for gated/private org repos (dev: export locally; prod: use Vault)
# HF_TOKEN=hf_...
# HUGGINGFACE_API_TOKEN=

# Enterprise / org sovereignty alignment (documentation + catalog namespace hints)
# HUGGINGFACE_ORG_NAMESPACE=your-org
# HUGGINGFACE_SOVEREIGNTY_MODE=dev-catalog-reference

# Future: Vault path for HF token in hosted environments
# HUGGINGFACE_VAULT_SECRET_PATH=secret/data/can/dev/huggingface
