# SIEM integration — environment variables
# Copy relevant lines into config.env / config/system.env

# Master switch (default: off for local dev)
SIEM_ENABLED=false

# Comma-separated providers: webhook, splunk, sentinel, oci
SIEM_PROVIDERS=webhook

# Environment label attached to every event
SIEM_ENVIRONMENT=dev

# --- Generic HTTP webhook (OCI Function, Elastic, custom collector) ---
SIEM_WEBHOOK_URL=
# Optional JSON headers, e.g. {"Authorization":"Bearer xxx"}
SIEM_WEBHOOK_HEADERS=

# --- Splunk HTTP Event Collector ---
SIEM_SPLUNK_HEC_URL=https://splunk.example.com:8088
SIEM_SPLUNK_HEC_TOKEN=
SIEM_SPLUNK_INDEX=can_security
SIEM_SPLUNK_SOURCETYPE=can:audit

# --- Microsoft Sentinel / Log Analytics Data Collector API ---
SIEM_SENTINEL_WORKSPACE_ID=
SIEM_SENTINEL_SHARED_KEY=
SIEM_SENTINEL_LOG_TYPE=CANAudit

# --- OCI Logging HTTP ingest (Function or Service Connector target) ---
SIEM_OCI_LOGGING_ENDPOINT=
SIEM_OCI_AUTH_HEADER=

# Application audit (database) — always on in production
AUDIT_LOGGING_ENABLED=true
AUDIT_RETENTION_DAYS=365
