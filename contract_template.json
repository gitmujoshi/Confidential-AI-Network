{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract Management System - Contract Template",
  "description": "Comprehensive JSON template for contracts in the Contract Management System supporting multi-tenant, multi-cloud AI training with provenance tracking",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Contract metadata and system information",
      "properties": {
        "templateVersion": {
          "type": "string",
          "description": "Version of this contract template",
          "example": "3.0.0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when contract was created",
          "example": "2024-12-15T10:30:00.000Z"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when contract was last modified",
          "example": "2024-12-15T10:30:00.000Z"
        },
        "contractType": {
          "type": "string",
          "enum": ["DATA_SHARING", "MODEL_TRAINING", "ANALYTICS", "CROSS_CLOUD_TRAINING", "CUSTOM"],
          "description": "Type of contract being created",
          "example": "CROSS_CLOUD_TRAINING"
        }
      },
      "required": ["templateVersion", "createdAt", "contractType"]
    },
    "contractId": {
      "type": "string",
      "description": "Unique human-readable contract identifier",
      "pattern": "^CONTRACT-[0-9]{13}$",
      "example": "CONTRACT-1705312200000"
    },
    "blockchainContractId": {
      "type": ["integer", "null"],
      "description": "Blockchain smart contract ID (null if not yet created on blockchain)",
      "example": 12345
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_TDP_APPROVAL",
        "PENDING_CCRP_APPROVAL", 
        "ACTIVE",
        "TRAINING_IN_PROGRESS",
        "COMPLETED",
        "CANCELLED"
      ],
      "description": "Current status of the contract in the workflow",
      "example": "PENDING_TDP_APPROVAL"
    },
    "parties": {
      "type": "object",
      "description": "All parties involved in the contract",
      "properties": {
        "tdp": {
          "type": "object",
          "description": "Training Data Provider (dataset owner)",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Database user ID",
              "example": 1
            },
            "name": {
              "type": "string",
              "description": "Full name of the TDP",
              "example": "Acme Data Corp"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address of the TDP",
              "example": "tdp@acmedata.com"
            },
            "walletAddress": {
              "type": ["string", "null"],
              "description": "Ethereum wallet address (optional for enterprise users)",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "example": "0x1234567890abcdef1234567890abcdef12345678"
            },
            "did": {
              "type": ["string", "null"],
              "description": "Decentralized Identifier",
              "example": "did:web:acmedata.com:user:123"
            },
            "partyType": {
              "type": "string",
              "enum": ["TDP"],
              "description": "Party type - always TDP for this role",
              "example": "TDP"
            },
            "organization": {
              "type": "string",
              "description": "Organization name",
              "example": "Acme Data Corporation"
            },
            "signed": {
              "type": "boolean",
              "description": "Whether TDP has signed the contract",
              "example": false
            },
            "signedAt": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "Timestamp when TDP signed (auto-signed when contract created)",
              "example": "2024-12-15T10:35:00.000Z"
            }
          },
          "required": ["id", "name", "email", "partyType", "signed"]
        },
        "tdc": {
          "type": "object",
          "description": "Training Data Consumer (contract initiator)",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Database user ID",
              "example": 2
            },
            "name": {
              "type": "string",
              "description": "Full name of the TDC",
              "example": "AI Training Inc"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address of the TDC",
              "example": "tdc@aitraining.com"
            },
            "walletAddress": {
              "type": ["string", "null"],
              "description": "Ethereum wallet address (optional for enterprise users)",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "example": "0xabcdef1234567890abcdef1234567890abcdef12"
            },
            "did": {
              "type": ["string", "null"],
              "description": "Decentralized Identifier",
              "example": "did:web:aitraining.com:user:456"
            },
            "partyType": {
              "type": "string",
              "enum": ["TDC"],
              "description": "Party type - always TDC for this role",
              "example": "TDC"
            },
            "organization": {
              "type": "string",
              "description": "Organization name",
              "example": "AI Training Incorporated"
            }
          },
          "required": ["id", "name", "email", "partyType"]
        },
        "ccrp": {
          "type": ["object", "null"],
          "description": "Confidential Clean Room Provider (optional)",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Database user ID",
              "example": 3
            },
            "name": {
              "type": "string",
              "description": "Full name of the CCRP",
              "example": "Secure Analytics LLC"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address of the CCRP",
              "example": "ccrp@secureanalytics.com"
            },
            "walletAddress": {
              "type": ["string", "null"],
              "description": "Ethereum wallet address (optional for enterprise users)",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "example": "0x9876543210fedcba9876543210fedcba98765432"
            },
            "did": {
              "type": ["string", "null"],
              "description": "Decentralized Identifier",
              "example": "did:web:secureanalytics.com:user:789"
            },
            "partyType": {
              "type": "string",
              "enum": ["CCRP"],
              "description": "Party type - always CCRP for this role",
              "example": "CCRP"
            },
            "organization": {
              "type": "string",
              "description": "Organization name",
              "example": "Secure Analytics LLC"
            }
          }
        }
      },
      "required": ["tdp", "tdc"]
    },
    "multiTenantInfrastructure": {
      "type": "object",
      "description": "Multi-tenant infrastructure specifications for each party",
      "properties": {
        "tdp": {
          "type": "object",
          "description": "TDP infrastructure configuration",
          "properties": {
            "cloudProvider": {
              "type": "string",
              "enum": ["AWS", "AZURE", "GCP", "ON_PREMISES"],
              "description": "Primary cloud provider for TDP",
              "example": "AWS"
            },
            "kmsProvider": {
              "type": "string",
              "enum": ["AWS_KMS", "AZURE_KEY_VAULT", "GCP_KMS", "HASHICORP_VAULT"],
              "description": "Key Management Service provider",
              "example": "AWS_KMS"
            },
            "storageProvider": {
              "type": "string",
              "enum": ["AWS_S3", "AZURE_BLOB", "GCP_GCS", "LOCAL_STORAGE"],
              "description": "Storage provider for datasets",
              "example": "AWS_S3"
            },
            "region": {
              "type": "string",
              "description": "Cloud region for infrastructure",
              "example": "us-east-1"
            },
            "infrastructureType": {
              "type": "string",
              "enum": ["PUBLIC_CLOUD", "PRIVATE_CLOUD", "HYBRID_CLOUD", "ON_PREMISES"],
              "description": "Type of infrastructure deployment",
              "example": "PUBLIC_CLOUD"
            },
            "complianceStandards": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compliance standards supported",
              "example": ["GDPR", "ISO27001", "SOC2", "HIPAA"]
            }
          },
          "required": ["cloudProvider", "kmsProvider", "storageProvider", "region"]
        },
        "tdc": {
          "type": "object",
          "description": "TDC infrastructure configuration",
          "properties": {
            "cloudProvider": {
              "type": "string",
              "enum": ["AWS", "AZURE", "GCP", "ON_PREMISES"],
              "description": "Primary cloud provider for TDC",
              "example": "AZURE"
            },
            "kmsProvider": {
              "type": "string",
              "enum": ["AWS_KMS", "AZURE_KEY_VAULT", "GCP_KMS", "HASHICORP_VAULT"],
              "description": "Key Management Service provider",
              "example": "AZURE_KEY_VAULT"
            },
            "storageProvider": {
              "type": "string",
              "enum": ["AWS_S3", "AZURE_BLOB", "GCP_GCS", "LOCAL_STORAGE"],
              "description": "Storage provider for models",
              "example": "AZURE_BLOB"
            },
            "region": {
              "type": "string",
              "description": "Cloud region for infrastructure",
              "example": "eastus"
            },
            "infrastructureType": {
              "type": "string",
              "enum": ["PUBLIC_CLOUD", "PRIVATE_CLOUD", "HYBRID_CLOUD", "ON_PREMISES"],
              "description": "Type of infrastructure deployment",
              "example": "PUBLIC_CLOUD"
            },
            "complianceStandards": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compliance standards supported",
              "example": ["GDPR", "ISO27001", "SOC2"]
            }
          },
          "required": ["cloudProvider", "kmsProvider", "storageProvider", "region"]
        },
        "ccrp": {
          "type": "object",
          "description": "CCRP infrastructure configuration",
          "properties": {
            "cloudProvider": {
              "type": "string",
              "enum": ["MULTI_CLOUD", "AWS", "AZURE", "GCP", "ON_PREMISES"],
              "description": "Cloud provider strategy for CCRP",
              "example": "MULTI_CLOUD"
            },
            "supportedClouds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["AWS", "AZURE", "GCP", "ON_PREMISES"]
              },
              "description": "List of supported cloud providers",
              "example": ["AWS", "AZURE", "GCP"]
            },
            "kmsProviders": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["AWS_KMS", "AZURE_KEY_VAULT", "GCP_KMS", "HASHICORP_VAULT"]
              },
              "description": "Supported KMS providers",
              "example": ["AWS_KMS", "AZURE_KEY_VAULT", "GCP_KMS"]
            },
            "storageProviders": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["AWS_S3", "AZURE_BLOB", "GCP_GCS", "LOCAL_STORAGE"]
              },
              "description": "Supported storage providers",
              "example": ["AWS_S3", "AZURE_BLOB", "GCP_GCS"]
            },
            "crossCloudOrchestration": {
              "type": "boolean",
              "description": "Whether cross-cloud orchestration is enabled",
              "example": true
            },
            "complianceStandards": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compliance standards supported",
              "example": ["GDPR", "ISO27001", "SOC2", "HIPAA", "DPDP_2023"]
            }
          },
          "required": ["cloudProvider", "supportedClouds"]
        }
      },
      "required": ["tdp", "tdc"]
    },
    "provenanceTracking": {
      "type": "object",
      "description": "Merkle tree provenance tracking configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether provenance tracking is enabled",
          "example": true
        },
        "trackingLevel": {
          "type": "string",
          "enum": ["BASIC", "COMPREHENSIVE", "AUDIT_READY"],
          "description": "Level of provenance tracking detail",
          "example": "COMPREHENSIVE"
        },
        "retentionPeriod": {
          "type": "string",
          "enum": ["30_DAYS", "90_DAYS", "1_YEAR", "PERMANENT"],
          "description": "How long to retain provenance data",
          "example": "PERMANENT"
        },
        "primaryNodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DATASET_ROOT",
              "MODEL_SPECIFICATION_ROOT", 
              "TRAINING_CONFIGURATION_ROOT",
              "TRAINED_MODEL_ROOT",
              "VALIDATION_RESULTS_ROOT",
              "PRIVACY_METRICS_ROOT"
            ]
          },
          "description": "Primary Merkle tree nodes to capture",
          "example": ["DATASET_ROOT", "MODEL_SPECIFICATION_ROOT", "TRAINED_MODEL_ROOT"]
        },
        "secondaryNodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DATA_PREPROCESSING",
              "FEATURE_ENGINEERING",
              "HYPERPARAMETER_TUNING",
              "TRAINING_CHECKPOINTS",
              "MODEL_EVALUATION",
              "PRIVACY_BUDGET_TRACKING"
            ]
          },
          "description": "Secondary Merkle tree nodes to capture",
          "example": ["DATA_PREPROCESSING", "TRAINING_CHECKPOINTS", "PRIVACY_BUDGET_TRACKING"]
        },
        "crossCloudVerification": {
          "type": "boolean",
          "description": "Whether to verify provenance across multiple clouds",
          "example": true
        },
        "auditCapabilities": {
          "type": "object",
          "description": "Audit capabilities configuration",
          "properties": {
            "modelExplainability": {
              "type": "boolean",
              "description": "Enable model explainability tracking",
              "example": true
            },
            "biasDetection": {
              "type": "boolean",
              "description": "Enable bias detection tracking",
              "example": true
            },
            "dataLineage": {
              "type": "boolean",
              "description": "Enable complete data lineage tracking",
              "example": true
            },
            "privacyMetrics": {
              "type": "boolean",
              "description": "Enable privacy metrics tracking",
              "example": true
            }
          },
          "required": ["modelExplainability", "biasDetection", "dataLineage", "privacyMetrics"]
        }
      },
      "required": ["enabled", "trackingLevel", "retentionPeriod", "primaryNodes"]
    },
    "dataset": {
      "type": "object",
      "description": "Dataset information and specifications",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Database dataset ID",
          "example": 1
        },
        "name": {
          "type": "string",
          "description": "Dataset name",
          "example": "Customer Behavior Dataset"
        },
        "description": {
          "type": "string",
          "description": "Detailed dataset description",
          "example": "High-quality customer behavior data for AI model training"
        },
        "category": {
          "type": "string",
          "enum": ["TEXT", "IMAGE", "AUDIO", "VIDEO", "TABULAR", "MULTIMODAL"],
          "description": "Dataset category",
          "example": "TABULAR"
        },
        "size": {
          "type": "string",
          "description": "Dataset size in human-readable format",
          "example": "2.5GB"
        },
        "format": {
          "type": "string",
          "description": "Dataset format",
          "example": "CSV"
        },
        "price": {
          "type": "string",
          "description": "Dataset price in ETH",
          "example": "500 ETH"
        },
        "metadata": {
          "type": "object",
          "description": "Additional dataset metadata",
          "properties": {
            "language": {
              "type": "string",
              "description": "Primary language of the data",
              "example": "English"
            },
            "domain": {
              "type": "string",
              "description": "Domain of the data",
              "example": "E-commerce"
            },
            "quality": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH"],
              "description": "Data quality rating",
              "example": "HIGH"
            },
            "encryptionKeyId": {
              "type": "string",
              "description": "KMS key ID for dataset encryption",
              "example": "tdp-dataset-key-001"
            },
            "storageLocation": {
              "type": "string",
              "description": "Storage location of the dataset",
              "example": "AWS_S3://medical-datasets/dataset-001"
            }
          }
        },
        "owner": {
          "type": "object",
          "description": "Dataset owner information",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Owner user ID",
              "example": 1
            },
            "name": {
              "type": "string",
              "description": "Owner name",
              "example": "Acme Data Corp"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Owner email",
              "example": "tdp@acmedata.com"
            },
            "did": {
              "type": ["string", "null"],
              "description": "Owner DID",
              "example": "did:web:acmedata.com:user:123"
            }
          },
          "required": ["id", "name", "email"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Dataset creation timestamp",
          "example": "2024-12-15T10:30:00.000Z"
        }
      },
      "required": ["id", "name", "description", "category", "size", "format", "price", "owner"]
    },
    "model": {
      "type": "object",
      "description": "AI model specifications",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Database model ID",
          "example": 1
        },
        "name": {
          "type": "string",
          "description": "Model name",
          "example": "Customer Churn Prediction Model"
        },
        "description": {
          "type": "string",
          "description": "Model description",
          "example": "Machine learning model for predicting customer churn"
        },
        "type": {
          "type": "string",
          "enum": ["CLASSIFICATION", "REGRESSION", "CLUSTERING", "NLP", "COMPUTER_VISION", "RECOMMENDATION"],
          "description": "Model type",
          "example": "CLASSIFICATION"
        },
        "algorithm": {
          "type": "string",
          "description": "Machine learning algorithm",
          "example": "Random Forest"
        },
        "hyperparameters": {
          "type": "object",
          "description": "Model hyperparameters",
          "properties": {
            "learningRate": {
              "type": "number",
              "description": "Learning rate",
              "example": 0.001
            },
            "batchSize": {
              "type": "integer",
              "description": "Batch size",
              "example": 32
            },
            "epochs": {
              "type": "integer",
              "description": "Number of training epochs",
              "example": 100
            }
          }
        },
        "privacyTechniques": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DIFFERENTIAL_PRIVACY",
              "SECURE_MULTIPARTY_COMPUTATION", 
              "HOMOMORPHIC_ENCRYPTION",
              "FEDERATED_LEARNING",
              "CONFIDENTIAL_COMPUTING"
            ]
          },
          "description": "Privacy-preserving techniques to be used",
          "example": ["DIFFERENTIAL_PRIVACY", "FEDERATED_LEARNING"]
        },
        "performanceMetrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Performance metrics to track",
          "example": ["accuracy", "precision", "recall", "f1_score"]
        },
        "owner": {
          "type": "object",
          "description": "Model owner information",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Owner user ID",
              "example": 2
            },
            "name": {
              "type": "string",
              "description": "Owner name",
              "example": "AI Training Inc"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Owner email",
              "example": "tdc@aitraining.com"
            },
            "did": {
              "type": ["string", "null"],
              "description": "Owner DID",
              "example": "did:web:aitraining.com:user:456"
            }
          },
          "required": ["id", "name", "email"]
        }
      },
      "required": ["id", "name", "description", "type", "algorithm", "owner"]
    },
    "financial": {
      "type": "object",
      "description": "Financial terms and payment information",
      "properties": {
        "totalPrice": {
          "type": "string",
          "description": "Total contract price in ETH",
          "example": "1000 ETH"
        },
        "datasetPrice": {
          "type": "string",
          "description": "Dataset price in ETH",
          "example": "500 ETH"
        },
        "modelPrice": {
          "type": "string",
          "description": "Model price in ETH",
          "example": "300 ETH"
        },
        "infrastructurePrice": {
          "type": "string",
          "description": "Infrastructure costs in ETH",
          "example": "200 ETH"
        },
        "paymentSchedule": {
          "type": "string",
          "enum": ["UPFRONT", "INSTALLMENTS", "UPON_COMPLETION"],
          "description": "Payment schedule",
          "example": "UPFRONT"
        },
        "installments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "description": "Installment amount"
              },
              "dueDate": {
                "type": "string",
                "format": "date-time",
                "description": "Due date for installment"
              },
              "status": {
                "type": "string",
                "enum": ["PENDING", "PAID", "OVERDUE"],
                "description": "Payment status"
              }
            }
          },
          "description": "Payment installments (if applicable)"
        },
        "currency": {
          "type": "string",
          "description": "Payment currency",
          "example": "ETH"
        },
        "exchangeRate": {
          "type": "number",
          "description": "ETH to USD exchange rate at contract creation",
          "example": 2500.0
        }
      },
      "required": ["totalPrice", "currency"]
    },
    "timeline": {
      "type": "object",
      "description": "Contract timeline and milestones",
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Contract start date",
          "example": "2024-12-15T10:30:00.000Z"
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Contract end date",
          "example": "2025-01-15T10:30:00.000Z"
        },
        "duration": {
          "type": "integer",
          "description": "Contract duration in days",
          "example": 30
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Milestone name"
              },
              "description": {
                "type": "string",
                "description": "Milestone description"
              },
              "dueDate": {
                "type": "string",
                "format": "date-time",
                "description": "Milestone due date"
              },
              "status": {
                "type": "string",
                "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "DELAYED"],
                "description": "Milestone status"
              }
            }
          },
          "description": "Contract milestones"
        }
      },
      "required": ["startDate", "endDate", "duration"]
    },
    "termsAndConditions": {
      "type": "object",
      "description": "Legal terms and conditions",
      "properties": {
        "legalDocument": {
          "type": "string",
          "description": "Human-readable legal document",
          "example": "This agreement is entered into between the Training Data Provider (TDP) and Training Data Consumer (TDC)..."
        },
        "dataUsageRights": {
          "type": "string",
          "description": "Data usage rights and restrictions",
          "example": "TDC may use the dataset solely for the specified AI model training purpose..."
        },
        "intellectualProperty": {
          "type": "string",
          "description": "Intellectual property terms",
          "example": "TDC retains ownership of the trained model, while TDP retains ownership of the original dataset..."
        },
        "liability": {
          "type": "string",
          "description": "Liability and indemnification terms",
          "example": "Each party shall indemnify the other against claims arising from their respective obligations..."
        },
        "termination": {
          "type": "string",
          "description": "Contract termination conditions",
          "example": "Either party may terminate this agreement with 30 days written notice..."
        },
